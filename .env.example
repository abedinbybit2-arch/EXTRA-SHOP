# Copy to .env.local and fill in with your own Firebase web app config.
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
#
# These are public client keys. Firestore security rules are what protect the
# data; see firestore.rules. Without them the storefront still runs, but the
# account, guest-session and sync features stay disabled.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Canonical origin for metadata, sitemap and robots. Defaults to the live site.
NEXT_PUBLIC_SITE_URL=
